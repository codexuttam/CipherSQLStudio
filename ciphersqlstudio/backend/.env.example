# Example environment variables for the CipherSQL backend
# Copy this file to .env and fill values for local development. Do NOT commit your real .env to git.

# Option A: full connection string (preferred)
# DATABASE_URL=postgresql://dbuser:secret@db.example.com:5432/mydb

# Option B: individual pieces (used if DATABASE_URL is not set)
DB_USER=postgres
DB_PASS=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres

# Pooling / timeouts
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONN_TIMEOUT_MS=2000

# SSL (set to true if your DB requires TLS)
DB_SSL=false
# If you need to skip cert verification (NOT recommended for production):
# DB_SSL_REJECT_UNAUTHORIZED=false

# Other vars
# PORT=4000
# GOOGLE_API_KEY=your_google_key
